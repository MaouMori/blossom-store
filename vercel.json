{
  "functions": {
    "api/render.js": {
      "includeFiles": [
        "index.html",
        "index2.html",
        "colecoes.html",
        "colecao.html",
        "loja.html",
        "loja2.html",
        "livro.html",
        "produto.html",
        "sobre.html"
      ]
    }
  },
  "routes": [
    { "src": "^/$", "dest": "/api/render?path=/index.html" },
    { "src": "^/(index|index2|colecoes|colecao|loja|loja2|livro|produto|sobre)\\.html$", "dest": "/api/render?path=/$1.html" },
    { "handle": "filesystem" }
  ]
}
